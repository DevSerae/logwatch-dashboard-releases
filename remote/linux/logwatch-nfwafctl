         "time-exceeded": "time-exceeded", "parameter-problem": "parameter-problem", "packet-too-big": "packet-too-big",
         "router-advertisement": "nd-router-advert", "router-solicitation": "nd-router-solicit", "redirect": "nd-redirect"}
